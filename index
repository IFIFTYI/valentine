<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Valentine 💘</title>
<style>
  body {
    background: linear-gradient(135deg, pink, #ffb6c1);
    height: 100vh;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
    overflow: hidden;
  }

  .box {
    text-align: center;
  }

  h1 {
    font-size: 42px;
    margin-bottom: 30px;
  }

  button {
    font-size: 20px;
    padding: 15px 30px;
    border: none;
    border-radius: 12px;
    cursor: pointer;
  }

  #yes {
    background: #ff4d6d;
    color: white;
    margin-right: 20px;
  }

  #no {
    background: #555;
    color: white;
    position: absolute;
  }
</style>
</head>

<body>
  <div class="box">
    <h1>💖 Will you be my Valentine? 💖</h1>
    <button id="yes" onclick="yesClicked()">Yes 💘</button>
    <button id="no">No 💔</button>
  </div>

<audio id="escapeSound" preload="auto">
  <source src="https://www.myinstants.com/media/sounds/cartoon-nope.mp3" type="audio/mpeg">
</audio>

<script>
  const noBtn = document.getElementById("no");
  const sound = document.getElementById("escapeSound");

  function moveButton() {
    const x = Math.random() * (window.innerWidth - noBtn.offsetWidth);
    const y = Math.random() * (window.innerHeight - noBtn.offsetHeight);
    noBtn.style.left = x + "px";
    noBtn.style.top = y + "px";

    sound.currentTime = 0;
    sound.play();
  }

  noBtn.addEventListener("mouseover", moveButton);

  noBtn.addEventListener("touchstart", function(e) {
    e.preventDefault();
    moveButton();
  });

  function yesClicked() {
    document.body.innerHTML = `
      <h1 style="color:white;text-align:center;">
        💕 Yay! I knew it! 💕<br><br>
        Happy Valentine 💘
      </h1>
    `;
  }
</script>
</body>
</html>
